# // ok
# Sao chép file này thành .env và điền giá trị thật
# cp .env.example .env

PORT=3000

# Database
DB_HOST=localhost        # Khi chạy local thì giữ là localhost
DB_PORT=3306             # Docker Compose sẽ ghi đè thành 3306 nội bộ
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=auth_demo

# JWT Secrets (thay bằng chuỗi ngẫu nhiên đủ dài trong production)
ACCESS_TOKEN_SECRET=your_access_token_secret_change_me
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_me

# Redis
REDIS_URL=redis://localhost:6379   # Docker Compose sẽ ghi đè thành redis://redis:6379
