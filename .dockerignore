# Các thư mục/file này sẽ KHÔNG được copy vào Docker image khi build
# Giúp image nhỏ hơn và không bị rò lộ thông tin nhạy cảm

# Dependencies (sẽ được cài lại bên trong container bằng npm ci)
node_modules

# Git history (không cần thiết trong production)
.git
.gitignore

# Biến môi trường thật (dùng env_file trong compose.yaml thay thế)
.env
.env.local

# Log files
*.log
npm-debug.log*

# Test files (không cần trong production image)
test-*.js
